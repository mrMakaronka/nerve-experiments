# agent-quality-langfuse/.env — scripts/langfuse-up.sh fills every Langfuse value with random secrets on first run.
# Never commit the real file. Values below are placeholders.

# Anthropic API key for the text-to-SQL agent (Claude Haiku 5.5). May instead live in the repo-root .env.
ANTHROPIC_API_KEY=<sk-ant-...>

# Langfuse API (the agent, langfuse-tools MCP and plot_v3.py read these)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=<pk-lf-... generated>
LANGFUSE_SECRET_KEY=<sk-lf-... generated>

# Langfuse UI login created by headless init
LANGFUSE_UI_EMAIL=demo@nerve.local
LANGFUSE_UI_PASSWORD=<generated>

# Langfuse docker compose internals (generated; mapped onto the compose file's variables by langfuse-up.sh)
LF_SALT=<generated>
LF_NEXTAUTH_SECRET=<generated>
LF_ENCRYPTION_KEY=<generated, 64 hex>
LF_POSTGRES_PASSWORD=<generated>
LF_CLICKHOUSE_PASSWORD=<generated>
LF_MINIO_ROOT_PASSWORD=<generated>
LF_REDIS_AUTH=<generated>

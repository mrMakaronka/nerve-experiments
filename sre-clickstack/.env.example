# sre-clickstack/.env — generated by scripts/clickstack-up.sh and scripts/up.sh. Never commit the real file.
# Values below are placeholders.

# ClickStack OTLP ingestion key (the collector tee sends it as the `authorization` header)
CLICKSTACK_INGESTION_API_KEY=<uuid generated by clickstack-up.sh>

# Read-only ClickHouse user used by the MCP server, chq.sh and the plot scripts
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=nerve_ro
CLICKHOUSE_PASSWORD=<random hex generated by clickstack-up.sh>

# Nerve API bearer token (passwordless install, from POST /api/auth/login; up.sh fills it in)
NERVE_TOKEN=<filled in by up.sh>

# HyperDX UI login created for screenshots (any email/password; local only)
HYPERDX_UI_EMAIL=demo@nerve.local
HYPERDX_UI_PASSWORD=<choose one>

# Kubeconfig: kind writes the context `kind-kind` into the default ~/.kube/config.
# Set KUBECONFIG only if you keep it elsewhere.
# KUBECONFIG=~/.kube/config

# Model auth (not stored here):
# - Anthropic / Claude implementer: up.sh reads this Mac's Claude Code login from the Keychain
#   (OAuth token, ~8 h). For longer runs: `claude setup-token`, then export CLAUDE_CODE_OAUTH_TOKEN.
# - Codex verifier: uses your ChatGPT login; up.sh copies ~/.codex/auth.json to ~/.nerve/codex/auth.json.

# HyperDX UI host port (default 8080; use another if 8080 is taken)
# HYPERDX_PORT=8081

# Shell knobs read from the environment, not from this file:
#   DEMO_PROBLEM        SREGym problem for sregym_ctl.py (default env_variable_shadowing_astronomy_shop)
#   SKIP_KIND=1         up.sh: reuse an existing kind cluster
#   NERVE_WS            up.sh: Nerve workspace dir (default ~/nerve-demo-workspace)
#   BASELINE_MIN, RUN_ONLY, REPEAT_CAFFEINATED   repeat.sh
#   CLAUDE_CODE_OAUTH_TOKEN                      long-lived Claude token (see above)
